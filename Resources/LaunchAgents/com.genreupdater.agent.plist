<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registered via SMAppService.agent(plistName:); the agent monitors the
	     library itself (launchd WatchPaths cannot express $HOME in a static
	     bundled plist), so it stays resident. ThrottleInterval matches the
	     Python launchd contract and bounds crash-relaunch churn. -->
	<key>Label</key>
	<string>com.genreupdater.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/GenreUpdaterAgent</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
